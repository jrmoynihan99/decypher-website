{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  // "functions" is a separate deployment target with its own tsconfig, its own
  // package.json and its own node_modules. Left in, the "**/*.ts" above pulls it
  // into the Next build — which typechecks fine locally, where functions/
  // node_modules exists, and fails on Vercel, where only the root package is
  // installed and firebase-functions isn't there.
  "exclude": ["node_modules", "functions"]
}
