# Copy to .env.local and fill in. Never commit .env.local.

# ── Sanity ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
SANITY_REVALIDATE_SECRET=
# local only — used by the migration script — do not add to Vercel
SANITY_API_WRITE_TOKEN=

# ── Calendly (SERVER ONLY — org-scoped, never expose to the browser) ────────
# calendly.com/integrations → API & webhooks → Get a token now. Generate it
# from the account that belongs to the client's org, not a personal one — a
# token only sees what its user's role can see. Booking needs a paid plan.
CALENDLY_API_TOKEN=
# Signs the webhook that feeds the portal's Sales Flow tab. Calendly shows this
# ONCE, when the subscription is created, and never again:
#   npm run sales:webhook -- create --url=https://wedecypher.co
# If UNSET the webhook route returns 500 rather than skipping the check —
# "no key configured" must not read as "no check needed", or anyone could POST
# fake bookings into the pipeline. Same posture as CRON_SECRET below.
CALENDLY_WEBHOOK_SIGNING_KEY=

# ── Resend: the estimator's lead email (SERVER ONLY) ────────────────────────
# resend.com → API Keys → Create. A send key can send as any address on a
# verified domain, so a leaked one can phish your own audience — rotate it if
# it ever lands anywhere it shouldn't (a chat, a screenshot, a commit).
RESEND_API_KEY=
# FALLBACKS ONLY: the live sender is Sanity → Site Settings → Email, editable
# without a deploy. These two are used when that section is empty or invalid.
#
# Envelope sender. Any address on the verified domain works and the mailbox
# does NOT have to exist — sending and receiving are separate. But if it can't
# receive, replies to it bounce, and leads do reply. Hence RESEND_REPLY_TO.
RESEND_FROM="DeCypher Financials <otavio@wedecypher.co>"
# Optional. Where replies actually land — set this to a real, monitored inbox.
# Unset means replies go to RESEND_FROM and die there if it's send-only.
RESEND_REPLY_TO=otavio@wedecypher.co

# ── Slack: notifications (SERVER ONLY) ──────────────────────────────────────
# Each Incoming Webhook is bound to ONE channel. Created in the CLIENT's
# workspace by someone who can install apps there: api.slack.com/apps → the app
# → Incoming Webhooks → Add New Webhook, pick the channel. Add a second webhook
# in the same app for a second channel. The URL is itself the credential —
# anyone holding it can post to that channel as this app. Unset is fine: the
# matching notification is skipped and the form still works.
#
# Estimator leads → #leads:
SLACK_WEBHOOK_URL=
# Careers applications → #recruiting:
SLACK_RECRUITING_WEBHOOK_URL=

# ── Firebase: browser SDK ───────────────────────────────────────────────────
# From Firebase console → Project settings → Your apps → SDK setup.
# These are NEXT_PUBLIC_ and ship to the browser — that's expected and safe.
# They identify the project, they don't authorise anything on their own.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase: admin SDK (SERVER ONLY — these are the keys to the kingdom) ────
# From Firebase console → Project settings → Service accounts →
# "Generate new private key". Pull these three fields out of the JSON.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# The whole PEM on one line, in double quotes, newlines left as literal \n —
# i.e. paste the JSON's private_key value verbatim, quotes and all.
FIREBASE_PRIVATE_KEY=""

# ── QuickBooks Online (SERVER ONLY) ─────────────────────────────────────────
# Powers the Creator Finances tab. Full setup walkthrough in docs/QUICKBOOKS.md.
#
# developer.intuit.com → your app → Keys & credentials. Sandbox keys are
# available immediately; PRODUCTION keys require Intuit's app assessment
# questionnaire to be submitted and approved, so start that early.
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
# Must match a redirect URI registered on the Intuit app EXACTLY, and is sent
# byte-identical on both /authorize and the token exchange. Never derived from
# the incoming request: a Vercel preview's origin isn't registered and Intuit
# rejects it. Consequence — connecting a company works on the production domain
# and on http://localhost:3000 only. Previews can read connections, not create
# them. Register both URLs on the app.
QUICKBOOKS_REDIRECT_URI=http://localhost:3000/api/portal/quickbooks/callback
# "sandbox" or "production". Sandbox and production realm ids are different
# companies entirely, so every read filters on this — flipping it hides one set
# of connections and reveals the other rather than mixing them.
QUICKBOOKS_ENV=sandbox
# Encrypts OAuth tokens at rest in Firestore (AES-256-GCM). 32 random bytes,
# base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Treat it like FIREBASE_PRIVATE_KEY: losing or rotating it means EVERY client
# company has to be reconnected by hand.
QUICKBOOKS_TOKEN_KEY=

# ── Cron (SERVER ONLY) ──────────────────────────────────────────────────────
# Guards /api/cron/*. The scheduled Cloud Functions in functions/ send it as a
# bearer token. If UNSET the routes return 500 rather than skipping the check —
# "no secret configured" must not read as "no check needed", or they'd be
# world-triggerable in silence.
# Any long random string: node -e "console.log(require('crypto').randomUUID())"
# Set the SAME value here and via `firebase functions:secrets:set CRON_SECRET`.
CRON_SECRET=
# How long a sync run may take before it stops cleanly and leaves the rest for
# the next one. Default 240000. Set to 45000 on Vercel Hobby, where functions
# are killed at 60s — the platform killing it mid-company records nothing.
# CRON_BUDGET_MS=
