# Copy to functions/.env — non-secret function params only.
#
# The deployed site the scheduled functions call, no trailing slash.
# This is where /api/cron/* lives, so it must be the PRODUCTION deployment —
# a preview URL changes every deploy and would silently stop being hit.
SITE_URL=https://wedecypher.co

# CRON_SECRET is NOT set here. It's a real credential — the only thing between
# the open internet and a sync run — so it lives in Secret Manager:
#
#   firebase functions:secrets:set CRON_SECRET
#
# Use the exact same value as CRON_SECRET in the Vercel environment.
