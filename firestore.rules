rules_version = '2';

/**
 * Deny everything.
 *
 * This isn't a placeholder — it's the design. Every read and write in the
 * portal goes through the Admin SDK on the server, and the Admin SDK bypasses
 * these rules entirely. So the browser needs zero direct Firestore access, and
 * the safest thing to grant it is nothing.
 *
 * If a future widget ever needs to talk to Firestore straight from the client,
 * that's the moment to open a specific, narrow hole here — not before.
 *
 * Paste this into: Firebase console → Firestore → Rules → Publish.
 */
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
